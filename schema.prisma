// FleetPulse data model.
// After changing this file, run `npx prisma migrate dev --name <description>`
// to create a migration and apply it to your database.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth models — shape matches what Better Auth expects. If you add or change
// auth plugins later, run `npx @better-auth/cli generate` and diff the
// result against this file rather than trusting either version blindly.
// ---------------------------------------------------------------------------

enum UserRole {
  OPS_MANAGER
  DISPATCHER
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(DISPATCHER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Fleet ops models — the actual product.
// ---------------------------------------------------------------------------

enum VehicleType {
  TRUCK
  VAN
  BUS
  TWO_WHEELER
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Vehicle {
  id                 String        @id @default(cuid())
  registrationNumber String        @unique
  type               VehicleType
  capacityKg         Int
  status             VehicleStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  trips Trip[]

  @@index([status])
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
}

model Driver {
  id            String       @id @default(cuid())
  name          String
  phone         String
  licenseNumber String       @unique
  status        DriverStatus @default(AVAILABLE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  trips Trip[]

  @@index([status])
}

enum TripStatus {
  SCHEDULED
  IN_TRANSIT
  DELAYED
  COMPLETED
  CANCELLED
}

model Trip {
  id String @id @default(cuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  originLabel      String
  originLat        Float
  originLng        Float
  destinationLabel String
  destinationLat   Float
  destinationLng   Float

  plannedDeparture DateTime
  actualDeparture  DateTime?
  plannedArrival   DateTime
  actualArrival    DateTime?

  distanceKm Float?
  status     TripStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stops Stop[]

  @@index([status])
  @@index([plannedDeparture])
  @@index([vehicleId])
}

enum StopStatus {
  PENDING
  ARRIVED
  SKIPPED
}

model Stop {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  sequence       Int
  label          String
  lat            Float
  lng            Float
  plannedArrival DateTime
  actualArrival  DateTime?
  status         StopStatus @default(PENDING)

  @@index([tripId])
}

// Cached output of the AI daily digest, keyed by day, so the LLM only ever
// gets called once per day instead of on every dashboard load.
model OpsDigest {
  id           String   @id @default(cuid())
  forDate      DateTime @unique
  summary      String
  totalTrips   Int
  delayedTrips Int
  onTimeRate   Float
  generatedAt  DateTime @default(now())
}
